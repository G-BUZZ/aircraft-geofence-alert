# Aircraft Geofence Alert configuration
# Copy this file to .env and replace the values before running the script.

# Public point of interest to monitor.
# Use generic/public coordinates only. Do not publish private home/work coordinates.
POINT_LAT=0.0000
POINT_LON=0.0000

# Search and alert parameters.
FETCH_RADIUS_KM=120.0
ALERT_RADIUS_KM=3.0
LOOKAHEAD_MINUTES=10.0
MIN_ALTITUDE_M=0.0
MAX_ALTITUDE_M=12000.0

# Optional ntfy notification topic.
# Use a long random topic. Never commit your real topic.
NTFY_TOPIC=your-private-random-ntfy-topic-here
